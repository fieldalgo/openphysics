      "prescribed_temperature": {
        "left": "300 K",
        "right": "300 K"
      }
    },
    "dc": {
      "type": "electric.steady2d",
      "prescribed_electric_potential": {
        "left": "0 V",
        "right": "0.2 V"
      }
    }
  },
  "couplings": {
    "joule_heat": {
      "from": "dc.joule_power_density",
      "to": "heat.heat_source_density",
      "transfer": "same_mesh"
