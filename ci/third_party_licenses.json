{
  "_comment": [
    "Reviewed license inventory for every Python distribution that may be installed in",
    "a validation or consumer environment. ci/check_licenses.py compares installed",
    "metadata against it. Add a reviewed entry before adding a dependency; a missing",
    "entry fails the check. Human-readable table: docs/third-party.md."
  ],
  "policy": {
    "permissive": [
      "0BSD", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "CC0-1.0", "ISC", "MIT",
      "MIT-0", "MIT-CMU", "PSF-2.0", "Python-2.0", "Unlicense", "Zlib",
      "LicenseRef-Matplotlib", "LicenseRef-Public-Domain"
    ],
    "weak_copyleft": [
      "LGPL-2.1-only", "LGPL-2.1-or-later", "LGPL-3.0-only", "LGPL-3.0-or-later", "MPL-2.0"
    ],
    "test_extras": ["test", "crosscheck"],
    "never": ["AGPL-1.0-only", "AGPL-1.0-or-later", "AGPL-3.0-only", "AGPL-3.0-or-later", "SSPL-1.0"],
    "rules": [
      "runtime and optional (non-test extras of first-party packages): permissive only",
      "test (extras named in test_extras) and tool: permissive, or weak copyleft when the entry sets test_only",
      "GPL: only entries with external_process; first-party code must not import them",
      "never: rejected in every environment"
    ]
  },
  "first_party": ["galerkin", "galerkin-refsol", "gmshio", "meshine", "openphysics", "physmat", "simcase"],
  "distributions": {
    "annotated-doc": {"spdx": "MIT", "url": "https://github.com/fastapi/annotated-doc"},
    "annotated-types": {"spdx": "MIT", "url": "https://github.com/annotated-types/annotated-types"},
    "anyio": {"spdx": "MIT", "url": "https://github.com/agronholm/anyio"},
    "build": {"spdx": "MIT", "url": "https://github.com/pypa/build"},
    "certifi": {"spdx": "MPL-2.0", "test_only": true,
                "url": "https://github.com/certifi/python-certifi",
                "review": "Unmodified CA bundle pulled in by httpx (simcase test extra) and requests (twine). Not a runtime dependency and never redistributed."},
    "cffi": {"spdx": "MIT-0", "url": "https://github.com/python-cffi/cffi"},
    "charset-normalizer": {"spdx": "MIT", "url": "https://github.com/jawah/charset_normalizer"},
    "click": {"spdx": "BSD-3-Clause", "url": "https://github.com/pallets/click"},
    "colorama": {"spdx": "BSD-3-Clause", "url": "https://github.com/tartley/colorama"},
    "contourpy": {"spdx": "BSD-3-Clause", "url": "https://github.com/contourpy/contourpy"},
    "cryptography": {"spdx": "Apache-2.0 OR BSD-3-Clause", "url": "https://github.com/pyca/cryptography"},
    "cycler": {"spdx": "BSD-3-Clause", "url": "https://github.com/matplotlib/cycler"},
    "docutils": {"spdx": "LicenseRef-Public-Domain AND BSD-2-Clause AND 0BSD",
                 "url": "https://docutils.sourceforge.io/COPYING.html",
                 "metadata_review": "The GPL classifier refers to files outside the wheel; COPYING.rst lists the shipped modules as public domain, BSD-2-Clause or 0BSD (eLyXer-derived files were relicensed to BSD-2-Clause). Reached only through twine's README check."},
    "fastapi": {"spdx": "MIT", "url": "https://github.com/fastapi/fastapi"},
    "fonttools": {"spdx": "MIT", "url": "https://github.com/fonttools/fonttools"},
    "gmsh": {"spdx": "GPL-2.0-or-later", "url": "https://gitlab.onelab.info/gmsh/gmsh/-/blob/master/LICENSE.txt",
             "external_process": {"executable": "gmsh", "forbidden_imports": ["gmsh"]},
             "review": "Only the gmsh executable is run as a separate process; its .msh output is read by original parsers. Never imported or bundled."},
    "h11": {"spdx": "MIT", "url": "https://github.com/python-hyper/h11"},
    "httpcore": {"spdx": "BSD-3-Clause", "url": "https://github.com/encode/httpcore"},
    "httpx": {"spdx": "BSD-3-Clause", "url": "https://github.com/encode/httpx"},
    "id": {"spdx": "Apache-2.0", "url": "https://github.com/di/id"},
    "idna": {"spdx": "BSD-3-Clause", "url": "https://github.com/kjd/idna"},
    "iniconfig": {"spdx": "MIT", "url": "https://github.com/pytest-dev/iniconfig"},
    "jaraco-classes": {"spdx": "MIT", "url": "https://github.com/jaraco/jaraco.classes"},
    "jaraco-context": {"spdx": "MIT", "url": "https://github.com/jaraco/jaraco.context"},
    "jaraco-functools": {"spdx": "MIT", "url": "https://github.com/jaraco/jaraco.functools"},
    "jeepney": {"spdx": "MIT", "url": "https://gitlab.com/takluyver/jeepney"},
    "keyring": {"spdx": "MIT", "url": "https://github.com/jaraco/keyring"},
    "kiwisolver": {"spdx": "BSD-3-Clause", "url": "https://github.com/nucleic/kiwi"},
    "markdown-it-py": {"spdx": "MIT", "url": "https://github.com/executablebooks/markdown-it-py"},
    "matplotlib": {"spdx": "LicenseRef-Matplotlib", "url": "https://matplotlib.org/stable/project/license.html",
                   "review": "PSF-based permissive license agreement; no SPDX identifier exists for it."},
    "mdurl": {"spdx": "MIT", "url": "https://github.com/executablebooks/mdurl"},
    "more-itertools": {"spdx": "MIT", "url": "https://github.com/more-itertools/more-itertools"},
    "nh3": {"spdx": "MIT", "url": "https://github.com/messense/nh3"},
    "numpy": {"spdx": "BSD-3-Clause AND 0BSD AND MIT AND Zlib AND CC0-1.0", "url": "https://github.com/numpy/numpy/blob/main/LICENSE.txt",
              "bundled": "Wheels bundle OpenBLAS (BSD-3-Clause) and, on Linux and Windows, the GCC Fortran runtime (GPL-3.0-or-later WITH GCC-exception-3.1)."},
    "opentelemetry-api": {"spdx": "Apache-2.0", "url": "https://github.com/open-telemetry/opentelemetry-python"},
    "packaging": {"spdx": "Apache-2.0 OR BSD-2-Clause", "url": "https://github.com/pypa/packaging"},
    "pillow": {"spdx": "MIT-CMU", "url": "https://github.com/python-pillow/Pillow"},
    "pip": {"spdx": "MIT", "url": "https://github.com/pypa/pip"},
    "pluggy": {"spdx": "MIT", "url": "https://github.com/pytest-dev/pluggy"},
    "pycparser": {"spdx": "BSD-3-Clause", "url": "https://github.com/eliben/pycparser"},
    "pydantic": {"spdx": "MIT", "url": "https://github.com/pydantic/pydantic"},
    "pydantic-core": {"spdx": "MIT", "url": "https://github.com/pydantic/pydantic-core"},
    "pygments": {"spdx": "BSD-2-Clause", "url": "https://github.com/pygments/pygments"},
    "pyparsing": {"spdx": "MIT", "url": "https://github.com/pyparsing/pyparsing"},
    "pyproject-hooks": {"spdx": "MIT", "url": "https://github.com/pypa/pyproject-hooks"},
    "pytest": {"spdx": "MIT", "url": "https://github.com/pytest-dev/pytest"},
    "python-dateutil": {"spdx": "Apache-2.0 AND BSD-3-Clause", "url": "https://github.com/dateutil/dateutil/blob/master/LICENSE"},
    "pyyaml": {"spdx": "MIT", "url": "https://github.com/yaml/pyyaml"},
    "readme-renderer": {"spdx": "Apache-2.0", "url": "https://github.com/pypa/readme_renderer"},
    "requests": {"spdx": "Apache-2.0", "url": "https://github.com/psf/requests"},
    "requests-toolbelt": {"spdx": "Apache-2.0", "url": "https://github.com/requests/toolbelt"},
    "rfc3986": {"spdx": "Apache-2.0", "url": "https://github.com/python-hyper/rfc3986"},
    "rich": {"spdx": "MIT", "url": "https://github.com/Textualize/rich"},
    "scikit-fem": {"spdx": "BSD-3-Clause", "url": "https://github.com/kinnala/scikit-fem",
                   "review": "Reference tool for code-to-code comparisons, galerkin[crosscheck] test extra; pure Python, requires only numpy and scipy."},
    "scipy": {"spdx": "BSD-3-Clause", "url": "https://github.com/scipy/scipy/blob/main/LICENSE.txt",
              "bundled": "Wheels bundle OpenBLAS (BSD-3-Clause) and, on Linux and Windows, the GCC Fortran runtime (GPL-3.0-or-later WITH GCC-exception-3.1)."},
    "secretstorage": {"spdx": "BSD-3-Clause", "url": "https://github.com/mitya57/secretstorage"},
    "setuptools": {"spdx": "MIT", "url": "https://github.com/pypa/setuptools"},
    "shapely": {"spdx": "BSD-3-Clause", "url": "https://github.com/shapely/shapely",
                "bundled": "Wheels bundle the GEOS shared library (LGPL-2.1-only), dynamically loaded and unmodified. OpenPhysics does not redistribute shapely or GEOS."},
    "six": {"spdx": "MIT", "url": "https://github.com/benjaminp/six"},
    "starlette": {"spdx": "BSD-3-Clause", "url": "https://github.com/Kludex/starlette"},
    "twine": {"spdx": "Apache-2.0", "url": "https://github.com/pypa/twine"},
    "typing-extensions": {"spdx": "PSF-2.0", "url": "https://github.com/python/typing_extensions"},
    "typing-inspection": {"spdx": "MIT", "url": "https://github.com/pydantic/typing-inspection"},
    "urllib3": {"spdx": "MIT", "url": "https://github.com/urllib3/urllib3"},
    "uvicorn": {"spdx": "BSD-3-Clause", "url": "https://github.com/Kludex/uvicorn"},
    "wheel": {"spdx": "MIT", "url": "https://github.com/pypa/wheel"}
  }
}
